# Copie este arquivo para .env.local e preencha. O .env.local nunca vai para o Git.
# Linhas em branco deixam a função desligada: o site avisa em vez de fingir que funciona.

# ---------------------------------------------------------------- Stripe (pagamento)
# Chave secreta: painel do Stripe > Developers > API keys.
# Enquanto sampleMode estiver true em src/config/site.ts, só chaves de teste (sk_test_...) são aceitas.
STRIPE_SECRET_KEY=

# Segredo do webhook (whsec_...): painel do Stripe > Developers > Webhooks > Add endpoint.
#   Endereço:  https://SEU-DOMINIO/api/stripe/webhook
#   Eventos:   checkout.session.completed, checkout.session.async_payment_succeeded,
#              checkout.session.async_payment_failed, checkout.session.expired,
#              payment_intent.payment_failed, charge.refunded
# No computador, use o Stripe CLI:  stripe listen --forward-to localhost:3300/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Supabase (pedidos e entregas)
# Painel do Supabase > Project Settings > API.
SUPABASE_URL=
# "Secret key" (sb_secret_...) ou a antiga "service_role". Dá acesso total ao banco: nunca exponha.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- Emails do pedido (Resend)
# Confirmação, pedido despachado, saiu para entrega e entregue. Sem estas duas linhas
# nada é enviado e a loja não promete email.
# Painel do Resend > API Keys. O domínio do remetente precisa estar verificado em Domains:
# sem isso o Resend só entrega para o email da própria conta dele, não para os clientes.
RESEND_API_KEY=
# Remetente, por exemplo:  Luxuswand <bestellung@seudominio.de>
EMAIL_FROM=

# ---------------------------------------------------------------- Painel da equipe (/admin)
# Quem pode entrar para ver os pedidos e registrar transportadora, código e situação do envio.
# Formato nome:senha, separados por vírgula. Use senhas longas e aleatórias
# (por exemplo com:  openssl rand -base64 24 ). Vazio = painel fechado.
ADMIN_ACCOUNTS=
# Opcional. Trocar este valor desconecta todo mundo do painel.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------- Parceiro de entrega
# Contrato completo em docs/delivery-partner-api.md.
#
# Quem pode ENVIAR atualizações de entrega para a loja. Uma chave por parceiro,
# no formato nome:chave, separados por vírgula. Invente chaves longas e aleatórias
# (por exemplo com:  openssl rand -hex 32 ) e entregue uma a cada parceiro.
DELIVERY_API_KEYS=

# Para onde a loja PEDE a criação da entrega quando um pedido é pago.
# O parceiro informa o endereço e a chave dele. O nome deve ser o mesmo usado acima.
DELIVERY_PARTNER_NAME=
DELIVERY_PARTNER_API_URL=
DELIVERY_PARTNER_API_KEY=

# ---------------------------------------------------------------- UTMify
# Painel da UTMify > Integrações > Webhooks > Credenciais de API.
UTMIFY_API_TOKEN=

# ---------------------------------------------------------------- Geral
# Endereço público do site, sem barra no final (ex.: https://www.sualoja.de).
# Pode ficar vazio no computador.
NEXT_PUBLIC_SITE_URL=

# Protege a rota que tenta de novo o que falhou (entregas não aceitas pelo parceiro,
# vendas não recebidas pela UTMify, emails não enviados). Invente um valor longo e aleatório.
# Na Vercel, um cron job chamando /api/internal/retry envia este valor sozinho.
CRON_SECRET=
